# ──────────────────────────────────────────────────────────
#  Evidencia API — Environment Configuration
# ──────────────────────────────────────────────────────────
#
#  Copy this file to .env and fill in the values.
#  Never commit .env to git.

# ── Server ────────────────────────────────────────────────
# HTTP port — Railway sets PORT automatically
PORT=3000

# Set to "production" to enforce auth and hide stack traces
NODE_ENV=development

# ── Authentication ────────────────────────────────────────
# Protects POST /v1/proofs and /v1/demo/proofs.
# Leave empty to disable auth (development only).
# Generate: openssl rand -hex 32
EVIDENCIA_API_KEY=

# Admin key for /v1/keys routes (falls back to EVIDENCIA_API_KEY)
# EVIDENCIA_ADMIN_KEY=

# ── Signing Keys ─────────────────────────────────────────
# Option A (dev): run `npm run keygen` → uses keys/ directory
#
# Option B (production / Railway): inject as env vars
# EVIDENCIA_PRIVATE_KEY=<base64 64-byte Ed25519 private key>
# EVIDENCIA_PUBLIC_KEY=<base64 32-byte Ed25519 public key>
# EVIDENCIA_KEY_ID=key_2025_08_A

# ── Database ──────────────────────────────────────────────
# Adapter: "sqlite" (default) or "pg"
DB_ADAPTER=sqlite

# SQLite — path to database file (default: ./db/evidencia.db)
# DB_PATH=./db/evidencia.db

# PostgreSQL — set DB_ADAPTER=pg and provide DATABASE_URL
# Railway injects DATABASE_URL automatically when you add a Postgres plugin.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "require" for Railway / cloud Postgres (self-signed certs)
# PGSSLMODE=require

# PG pool tuning (sensible defaults, rarely need changing)
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT=30000
# PG_CONNECT_TIMEOUT=5000

# ── Contact Form (optional) ──────────────────────────────
# RESEND_API_KEY=re_xxxx
# CONTACT_TO=hello@evidencia.io
# CONTACT_FROM=Evidencia Contact <noreply@evidencia.io>
