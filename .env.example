# ──────────────────────────────────────────────────────────
#  Evidencia API — Environment Configuration
# ──────────────────────────────────────────────────────────
#
#  Copy this file to .env and fill in the values.
#  Never commit .env to git.

# HTTP port (default: 3000)
PORT=3000

# Environment
NODE_ENV=development

# ── Authentication ──────────────────────────────────────────
# Set to any secret string to protect the proof creation endpoint.
# Leave empty to disable authentication (development only).
# Example: openssl rand -hex 32
EVIDENCIA_API_KEY=evd_sk_dev_changeme

# ── Signing Keys ────────────────────────────────────────────
# Option A (recommended for dev): use keys/ directory
#   Run:  npm run keygen
#   Keys will be stored in keys/private.key and keys/public.key
#
# Option B: inject as environment variables (production / containers)
# EVIDENCIA_PRIVATE_KEY=<base64-encoded 64-byte Ed25519 private key>
# EVIDENCIA_PUBLIC_KEY=<base64-encoded 32-byte Ed25519 public key>
# EVIDENCIA_KEY_ID=key_2025_08_A

# ── Storage ─────────────────────────────────────────────────
# Path to SQLite database file (default: ./db/evidencia.db)
# DB_PATH=./db/evidencia.db

# Path to signing keys directory (default: ./keys)
# KEY_DIR=./keys
